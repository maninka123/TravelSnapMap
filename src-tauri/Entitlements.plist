<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime entitlements for signed builds. The app and its Photos helper read the Photos library;
     nothing else (camera, microphone, contacts…) is requested. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.personal-information.photos-library</key>
  <true/>
</dict>
</plist>
