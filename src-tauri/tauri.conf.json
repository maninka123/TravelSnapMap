{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TravelSnapMap",
  "version": "0.5.0",
  "identifier": "com.travelsnapmap.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TravelSnapMap",
        "width": 1320,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https://tiles.openfreemap.org",
        "media-src": "'self' asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost https://tiles.openfreemap.org",
        "worker-src": "'self' blob:",
        "child-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$APPCACHE/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/photos-bridge"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "Entitlements.plist",
      "hardenedRuntime": true,
      "signingIdentity": null,
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 380
        }
      }
    },
    "category": "Travel",
    "shortDescription": "Your travel screenshots and Reels, on a map",
    "longDescription": "TravelSnapMap turns travel screenshots and Instagram Reels into a private, organised map of places, tips and trips. Text is read on your Mac; places are located with Apple Maps.",
    "copyright": "© 2026 TravelSnapMap"
  }
}
